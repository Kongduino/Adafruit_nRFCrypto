static const uint8_t rsaPubExponent[3] = { 0x01, 0x00, 0x01 };  // 65537

nRFCrypto_RSA_PublicKey rsaPub;
nRFCrypto_RSA_PrivateKey rsaPriv;

static void printHex(const uint8_t* buf, size_t len) {
  for (size_t i = 0; i < len; i++) {
    if (buf[i] < 0x10) Serial.print('0');
    Serial.print(buf[i], HEX);
  }
  Serial.println();
}

void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);  // remove if running without a serial monitor
  Serial.println("--- nRFCrypto_RSA demo (RSA-2048, PKCS#1 v1.5) ---");

  nRFCrypto.begin();

  if (!rsaPub.begin(rsaModulus, sizeof(rsaModulus), rsaPubExponent, sizeof(rsaPubExponent))) {
    Serial.println("Public key build failed");
    while (1)
      ;
  }
  if (!rsaPriv.begin(rsaModulus, sizeof(rsaModulus), rsaPrivExponent, sizeof(rsaPrivExponent),
                     rsaPubExponent, sizeof(rsaPubExponent))) {
    Serial.println("Private key build failed");
    while (1)
      ;
  }
  Serial.print("Modulus size: ");
  Serial.print(rsaPub.getModulusSize() * 8);
  Serial.println(" bits");

  const char* text = "Hello from Arduino nRF52840!";
  const uint8_t* msg = (const uint8_t*)text;
  size_t msg_len = strlen(text);

  uint8_t sig[256];  // must be >= rsaPub.getModulusSize()
  uint32_t t0 = millis();
  uint16_t sigLen = nRFCrypto_RSA::sign(rsaPriv, CRYS_RSA_HASH_SHA256_mode, msg, msg_len, sig, sizeof(sig));
  uint32_t signMs = millis() - t0;
  if (sigLen == 0) {
    Serial.println("Sign failed");
    while (1)
      ;
  }
  Serial.print("Signature (");
  Serial.print(signMs);
  Serial.println(" ms):");
  printHex(sig, sigLen);

  t0 = millis();
  bool ok = nRFCrypto_RSA::verify(rsaPub, CRYS_RSA_HASH_SHA256_mode, msg, msg_len, sig, sigLen);
  Serial.print("Verify (good msg, ");
  Serial.print(millis() - t0);
  Serial.print(" ms): ");
  Serial.println(ok ? "VALID" : "INVALID");

  // Tamper test: flip one bit, verification should fail
  uint8_t bad[256];
  memcpy(bad, sig, sigLen);
  bad[0] ^= 1;
  Serial.print("Verify (bad sig):  ");
  Serial.println(nRFCrypto_RSA::verify(rsaPub, CRYS_RSA_HASH_SHA256_mode, msg, msg_len, bad, sigLen) ? "VALID (unexpected!)" : "INVALID (expected)");
}

